        <resourceRef>role-desk-supervisor</resourceRef>
      </potentialOwner>
    </userTask>
    <boundaryEvent id="deadline-approve" attachedToRef="step-approve" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">P3D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <exclusiveGateway id="decision-approve" name="approved?" default="flow-7"/>
    <serviceTask id="step-waive" name="waive" operationRef="operation-waiveFee"/>
    <boundaryEvent id="failure-waive" attachedToRef="step-waive" cancelActivity="true">
      <errorEventDefinition/>
    </boundaryEvent>
    <endEvent id="end-done" name="done"/>
    <endEvent id="end-refused" name="refused"/>
    <endEvent id="end-failed" name="failed"/>
    <sequenceFlow id="flow-1" sourceRef="start" targetRef="step-route"/>
    <sequenceFlow id="flow-2" name="otherwise" sourceRef="step-route" targetRef="step-approve"/>
    <sequenceFlow id="flow-3" sourceRef="step-approve" targetRef="decision-approve"/>
    <sequenceFlow id="flow-4" name="approved" sourceRef="decision-approve" targetRef="step-waive">
      <conditionExpression xsi:type="tFormalExpression">approved</conditionExpression>
