      </timerEventDefinition>
    </boundaryEvent>
    <exclusiveGateway id="decision-approve" name="approved?" default="flow-5"/>
    <serviceTask id="step-writeOff" name="writeOff" operationRef="operation-writeOffLoan"/>
    <endEvent id="end-done" name="done"/>
    <endEvent id="end-refused" name="refused"/>
    <sequenceFlow id="flow-1" sourceRef="start" targetRef="step-approve"/>
    <sequenceFlow id="flow-2" sourceRef="step-approve" targetRef="decision-approve"/>
    <sequenceFlow id="flow-3" name="approved" sourceRef="decision-approve" targetRef="step-writeOff">
      <conditionExpression xsi:type="tFormalExpression">approved</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-4" sourceRef="step-writeOff" targetRef="end-done"/>
    <sequenceFlow id="flow-5" name="refused" sourceRef="decision-approve" targetRef="end-refused"/>
    <sequenceFlow id="flow-6" name="after P2D" sourceRef="deadline-approve" targetRef="end-refused"/>
  </process>
