"Medium","urls":["https://github.com/vercel/next.js/commit/4f133352e639589ad9872b9b55307b89b258e41b","https://github.com/vercel/next.js/commit/e66e656e7d423a828bdca5f87e82cef7038c57a6","https://github.com/vercel/next.js/releases/tag/v15.5.29","https://github.com/vercel/next.js/releases/tag/v16.4.5","https://github.com/vercel/next.js/security/advisories/GHSA-7qx7-33qx-rqx2","https://nextjs.org/blog/november-2026-security-release"],"description":"Next.js is a React framework for building full-stack web applications. From 15.0.0 until 15.5.29 and 16.4.5, the /_next/image optimizer in self-hosted Next.js deployments can process attacker-supplied SVG content even when dangerouslyAllowSVG is false, which is the default. The SVG reaches a parser that the application intended to keep disabled, increasing exposure to denial of service and vulnerabilities in SVG decoding. This issue is fixed in versions 16.4.5 and 15.5.29.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":6.9},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-119347","epss":0.00328,"percentile":0.26112,"date":"2026-11-24"}],"cwes":[{"cve":"CVE-2026-119347","cwe":"CWE-1287","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"next","version":"16.4.1"}},"found":{"vulnerabilityID":"GHSA-7qx7-33qx-rqx2","versionConstraint":">=16.0.0,<=16.4.4 (semantic)"},"fix":{"suggestedVersion":"16.4.5"}}],"artifact":{"id":"pkg:npm/next@16.4.1?package-id=0337ccfbbb37b149","name":"next","version":"16.4.1","type":"npm","locations":[{"path":"/examples/library-lending/web-nextjs/pnpm-lock.yaml","accessPath":""}