{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "specarch",
          "informationUri": "https://github.com/SpecArch/specarch",
          "rules": [
            {
              "id": "stakeholders_unconfirmed"
            },
            {
              "id": "yaml_syntax"
            }
          ]
        }
      },
      "columnKind": "unicodeCodePoints",
      "results": [
        {
          "ruleId": "yaml_syntax",
          "kind": "fail",
          "level": "error",
          "message": {
            "text": "the { that starts on this line is not closed; close it with }, and separate its entries with commas; the other entries of the file are read, and this one is kept by its name only until it parses"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "../project/case.go.specarch-implementation.yaml",
                  "uriBaseId": "PROBLEMSDIR"
                },
                "region": {
                  "startLine": 7,
                  "startColumn": 21
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "/mappings/#~1entities~1Book",
                  "kind": "element"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "specarchId/v1": "yaml_syntax@case.go.specarch-implementation.yaml#/mappings/#~1entities~1Book"
          }
        },
        {
          "ruleId": "stakeholders_unconfirmed",
          "kind": "fail",
          "level": "warning",
          "message": {
            "text": "the stakeholder list is not confirmed complete, so a role with an interest in the system may still be missing from it; once it is complete, add stakeholdersComplete with by, the role that confirms it, date and source, which ends this warning, the banner on every generated document and the warning of specarch approve"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "../project/specarch.yaml",
                  "uriBaseId": "PROBLEMSDIR"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "fullyQualifiedName": "/stakeholders",
                  "kind": "element"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "specarchId/v1": "stakeholders_unconfirmed@specarch.yaml#/stakeholders"
          }
        }
      ],
      "properties": {
        "specification": "../project",
        "title": "Case",
        "version": "1.0.0"
      }
    }
  ]
}
