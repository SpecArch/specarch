  <message id="message-askRefund" name="askRefund request"/>
  <message id="message-payRefund" name="payRefund request"/>
  <message id="message-faxNotice" name="faxNotice request"/>
  <resource id="role-clerk" name="clerk"/>
  <!-- specarch-problem: warning: test_case_missing: workflow refund has no red scenario for "route goes on at hold"; add under tests refund-route-goes-on-at-hold: { workflow: refund, scenario: red, covers: [route goes on at hold], given: "a request reaching route for which no other branch holds", when: "the decision is taken", then: "the request goes on at hold" } [test_case_missing.24d64403@specarch.yaml#/workflows/refund] -->
  <!-- specarch-problem: warning: test_case_missing: workflow refund has no red scenario for "refused at approve"; add under tests refund-refused-at-approve: { workflow: refund, scenario: red, covers: [refused at approve], given: "a request waiting at approve", when: "a caller with refunds.approve refuses it", then: "the request ends refused and holdFunds and payRefund is not called" } [test_case_missing.333fe403@specarch.yaml#/workflows/refund] -->
