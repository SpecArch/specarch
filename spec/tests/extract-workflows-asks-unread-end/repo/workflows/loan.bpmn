<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions-loan" targetNamespace="urn:example:loan">
  <message id="message-returned" name="loans/BookReturned"/>
  <process id="process" name="loan" isExecutable="false">
    <startEvent id="start"/>
    <receiveTask id="step-returned" name="returned" messageRef="message-returned"/>
    <boundaryEvent id="returned-late" attachedToRef="step-returned">
      <timerEventDefinition>
        <timeDuration>P14D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <exclusiveGateway id="step-check" name="check" default="flow-4"/>
    <endEvent id="end-rejected" name="Rejected"/>
    <endEvent id="end-approved" name="Approved"/>
    <sequenceFlow id="flow-1" sourceRef="start" targetRef="step-returned"/>
    <sequenceFlow id="flow-2" sourceRef="step-returned" targetRef="step-check"/>
    <sequenceFlow id="flow-3" sourceRef="step-check" targetRef="end-rejected">
      <conditionExpression xsi:type="tFormalExpression" language="urn:specarch:expression">overdueCount &gt; 2</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-4" sourceRef="step-check" targetRef="end-approved"/>
    <sequenceFlow id="flow-5" sourceRef="returned-late" targetRef="end-approved"/>
  </process>
</definitions>
