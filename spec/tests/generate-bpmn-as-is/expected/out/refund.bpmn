    <!-- specarch-problem: warning: test_case_missing: operation faxNotice has no red scenario for "denied without refunds.pay"; add under tests fax-notice-denied-without-refunds-pay: { operation: faxNotice, scenario: red, covers: [denied without refunds.pay], given: "a caller without refunds.pay", when: "faxNotice is called", then: "it is refused as not allowed" } [test_case_missing@specarch.yaml#/paths/~1refunds~1fax/post] -->
    <!-- specarch-problem: warning: test_golden_missing: operation faxNotice has no golden scenario; add one under tests, for example fax-notice-succeeds: { operation: faxNotice, scenario: golden, given: "a caller with refunds.pay", when: "faxNotice is called", then: "it answers 200: Faxed." } [test_golden_missing@specarch.yaml#/paths/~1refunds~1fax/post] -->
