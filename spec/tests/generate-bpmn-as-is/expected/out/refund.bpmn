      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-decision-approve" bpmnElement="decision-approve" isMarkerVisible="true">
        <dc:Bounds x="476" y="47" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-step-pay" bpmnElement="step-pay">
        <dc:Bounds x="586" y="32" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-step-notify" bpmnElement="step-notify">
        <dc:Bounds x="756" y="32" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-end-done" bpmnElement="end-done">
