    <!-- specarch-problem: warning: test_case_missing: operation grantWaiver has no red scenario for "not found waiverId"; add under tests grant-waiver-not-found-waiver-id: { operation: grantWaiver, scenario: red, covers: [not found waiverId], given: "no record has that waiverId", when: "grantWaiver is called with that waiverId", then: "it is refused as not found" } [test_case_missing.76f0f6d0@specarch.yaml#/paths/~1waivers~1{waiverId}~1grant/post] -->
    <!-- specarch-problem: warning: test_case_missing: operation grantWaiver has no red scenario for "denied without waivers.decide"; add under tests grant-waiver-denied-without-waivers-decide: { operation: grantWaiver, scenario: red, covers: [denied without waivers.decide], given: "a caller without waivers.decide", when: "grantWaiver is called", then: "it is refused as not allowed" } [test_case_missing.d18a3a81@specarch.yaml#/paths/~1waivers~1{waiverId}~1grant/post] -->
