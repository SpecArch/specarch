  <process id="process" name="refund" isExecutable="false">
    <documentation>A clerk checks every refund and approves it; it is paid, and a notice is faxed.</documentation>
    <laneSet id="lanes">
      <lane id="lane" name="Case">
        <flowNodeRef>start</flowNodeRef>
        <flowNodeRef>decision-approve</flowNodeRef>
        <flowNodeRef>step-pay</flowNodeRef>
        <flowNodeRef>step-notify</flowNodeRef>
        <flowNodeRef>end-done</flowNodeRef>
        <flowNodeRef>end-refused</flowNodeRef>
      </lane>
      <lane id="lane-clerk" name="clerk">
        <flowNodeRef>step-check</flowNodeRef>
        <flowNodeRef>step-approve</flowNodeRef>
        <flowNodeRef>deadline-approve</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="start" name="askRefund">
      <messageEventDefinition messageRef="message-askRefund">
        <operationRef>operation-askRefund</operationRef>
      </messageEventDefinition>
    </startEvent>
    <userTask id="step-check" name="check">
      <potentialOwner>
        <resourceRef>role-clerk</resourceRef>
      </potentialOwner>
    </userTask>
    <userTask id="step-approve" name="approve">
      <potentialOwner>
        <resourceRef>role-clerk</resourceRef>
      </potentialOwner>
    </userTask>
    <boundaryEvent id="deadline-approve" attachedToRef="step-approve" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">P5D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <exclusiveGateway id="decision-approve" name="approved?" default="flow-7"/>
    <serviceTask id="step-pay" name="pay" operationRef="operation-payRefund"/>
    <!-- specarch-problem: question: open_question: (could, decision) Is the notice still faxed, or only mailed? Decided by owner. Answer with a decision record that names Q-1 under answers. [Q-1] -->
    <serviceTask id="step-notify" name="notify" operationRef="operation-faxNotice"/>
    <endEvent id="end-done" name="done"/>
    <endEvent id="end-refused" name="refused"/>
    <sequenceFlow id="flow-1" sourceRef="start" targetRef="step-check"/>
    <sequenceFlow id="flow-2" sourceRef="step-check" targetRef="step-approve"/>
    <sequenceFlow id="flow-3" sourceRef="step-approve" targetRef="decision-approve"/>
    <sequenceFlow id="flow-4" name="approved" sourceRef="decision-approve" targetRef="step-pay">
      <conditionExpression xsi:type="tFormalExpression">approved</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-5" sourceRef="step-pay" targetRef="step-notify"/>
    <sequenceFlow id="flow-6" sourceRef="step-notify" targetRef="end-done"/>
    <sequenceFlow id="flow-7" name="refused" sourceRef="decision-approve" targetRef="end-refused"/>
    <sequenceFlow id="flow-8" name="after P5D" sourceRef="deadline-approve" targetRef="end-refused"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram-refund">
    <bpmndi:BPMNPlane id="plane-refund" bpmnElement="process">
      <bpmndi:BPMNShape id="shape-lane" bpmnElement="lane" isHorizontal="true">
        <dc:Bounds x="10" y="10" width="1002" height="188"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-lane-clerk" bpmnElement="lane-clerk" isHorizontal="true">
        <dc:Bounds x="10" y="198" width="1002" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-start" bpmnElement="start">
        <dc:Bounds x="40" y="54" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-step-check" bpmnElement="step-check">
