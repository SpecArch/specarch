<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions-refund" targetNamespace="urn:specarch:workflows:refund">
  <interface id="interface" name="Case">
    <operation id="operation-askRefund" name="askRefund">
      <inMessageRef>message-askRefund</inMessageRef>
    </operation>
    <operation id="operation-holdFunds" name="holdFunds">
      <inMessageRef>message-holdFunds</inMessageRef>
    </operation>
    <operation id="operation-releaseFunds" name="releaseFunds">
      <inMessageRef>message-releaseFunds</inMessageRef>
    </operation>
    <operation id="operation-payRefund" name="payRefund">
      <inMessageRef>message-payRefund</inMessageRef>
    </operation>
    <operation id="operation-closeRefund" name="closeRefund">
      <inMessageRef>message-closeRefund</inMessageRef>
    </operation>
  </interface>
  <message id="message-askRefund" name="askRefund request"/>
  <message id="message-holdFunds" name="holdFunds request"/>
  <message id="message-releaseFunds" name="releaseFunds request"/>
  <message id="message-payRefund" name="payRefund request"/>
  <message id="message-closeRefund" name="closeRefund request"/>
  <message id="event-refunds.RefundPaid" name="refunds/RefundPaid"/>
  <resource id="role-manager" name="manager"/>
  <resource id="role-clerk" name="clerk"/>
  <process id="process" name="refund" isExecutable="false">
    <documentation>A refund is routed by its amount, checked by a clerk, paid, and closed once the payment is confirmed.</documentation>
    <laneSet id="lanes">
      <lane id="lane" name="Case">
        <flowNodeRef>start</flowNodeRef>
        <flowNodeRef>step-route</flowNodeRef>
        <flowNodeRef>decision-approve</flowNodeRef>
        <flowNodeRef>step-hold</flowNodeRef>
        <flowNodeRef>compensation-hold</flowNodeRef>
        <flowNodeRef>undo-hold</flowNodeRef>
        <flowNodeRef>step-pay</flowNodeRef>
        <flowNodeRef>failure-pay</flowNodeRef>
        <flowNodeRef>step-confirmed</flowNodeRef>
        <flowNodeRef>deadline-confirmed</flowNodeRef>
        <flowNodeRef>step-cool</flowNodeRef>
        <flowNodeRef>step-due</flowNodeRef>
        <flowNodeRef>step-close</flowNodeRef>
        <flowNodeRef>failure-close</flowNodeRef>
        <flowNodeRef>step-due2</flowNodeRef>
        <flowNodeRef>end-done</flowNodeRef>
        <flowNodeRef>end-refused</flowNodeRef>
        <flowNodeRef>end-failed</flowNodeRef>
      </lane>
      <lane id="lane-manager" name="manager">
        <flowNodeRef>step-approve</flowNodeRef>
        <flowNodeRef>deadline-approve</flowNodeRef>
        <flowNodeRef>step-recheck</flowNodeRef>
      </lane>
      <lane id="lane-clerk" name="clerk">
        <flowNodeRef>step-check</flowNodeRef>
        <flowNodeRef>deadline-check</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="start" name="askRefund">
      <messageEventDefinition messageRef="message-askRefund">
        <operationRef>operation-askRefund</operationRef>
      </messageEventDefinition>
    </startEvent>
    <exclusiveGateway id="step-route" name="route" default="flow-5"/>
    <userTask id="step-approve" name="approve">
      <potentialOwner>
        <resourceRef>role-manager</resourceRef>
      </potentialOwner>
    </userTask>
    <boundaryEvent id="deadline-approve" attachedToRef="step-approve" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">P2D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <exclusiveGateway id="decision-approve" name="approved?" default="flow-15"/>
    <userTask id="step-check" name="check">
      <potentialOwner>
        <resourceRef>role-clerk</resourceRef>
      </potentialOwner>
    </userTask>
    <boundaryEvent id="deadline-check" attachedToRef="step-check" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">P1D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <userTask id="step-recheck" name="recheck">
      <potentialOwner>
        <resourceRef>role-manager</resourceRef>
      </potentialOwner>
    </userTask>
    <serviceTask id="step-hold" name="hold" operationRef="operation-holdFunds"/>
    <boundaryEvent id="compensation-hold" attachedToRef="step-hold">
      <compensateEventDefinition/>
    </boundaryEvent>
    <serviceTask id="undo-hold" name="undo hold" isForCompensation="true" operationRef="operation-releaseFunds"/>
    <serviceTask id="step-pay" name="pay" operationRef="operation-payRefund"/>
    <boundaryEvent id="failure-pay" attachedToRef="step-pay" cancelActivity="true">
      <errorEventDefinition/>
    </boundaryEvent>
    <receiveTask id="step-confirmed" name="confirmed" messageRef="event-refunds.RefundPaid"/>
    <boundaryEvent id="deadline-confirmed" attachedToRef="step-confirmed" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">P5D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <intermediateCatchEvent id="step-cool" name="cool">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">P1D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="step-due" name="due">
      <timerEventDefinition>
        <timeDate xsi:type="tFormalExpression" language="urn:specarch:expression">payBy</timeDate>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <serviceTask id="step-close" name="close" operationRef="operation-closeRefund"/>
    <boundaryEvent id="failure-close" attachedToRef="step-close" cancelActivity="true">
      <errorEventDefinition/>
    </boundaryEvent>
    <intermediateCatchEvent id="step-due2" name="due2">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">PT1H</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <endEvent id="end-done" name="done"/>
    <endEvent id="end-refused" name="refused">
      <compensateEventDefinition/>
    </endEvent>
    <endEvent id="end-failed" name="failed">
      <compensateEventDefinition/>
    </endEvent>
    <sequenceFlow id="flow-1" sourceRef="start" targetRef="step-route"/>
    <sequenceFlow id="flow-2" name="amountCents &gt; 10000" sourceRef="step-route" targetRef="step-approve">
      <conditionExpression xsi:type="tFormalExpression" language="urn:specarch:expression">amountCents &gt; 10000</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-3" sourceRef="step-approve" targetRef="decision-approve"/>
    <sequenceFlow id="flow-4" name="approved" sourceRef="decision-approve" targetRef="step-check">
      <conditionExpression xsi:type="tFormalExpression">approved</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-5" name="otherwise" sourceRef="step-route" targetRef="step-check"/>
    <sequenceFlow id="flow-6" sourceRef="step-check" targetRef="step-recheck"/>
    <sequenceFlow id="flow-7" sourceRef="step-recheck" targetRef="step-hold"/>
    <sequenceFlow id="flow-8" sourceRef="step-hold" targetRef="step-pay"/>
    <sequenceFlow id="flow-9" sourceRef="step-pay" targetRef="step-confirmed"/>
    <sequenceFlow id="flow-10" sourceRef="step-confirmed" targetRef="step-cool"/>
    <sequenceFlow id="flow-11" sourceRef="step-cool" targetRef="step-due"/>
    <sequenceFlow id="flow-12" sourceRef="step-due" targetRef="step-close"/>
    <sequenceFlow id="flow-13" sourceRef="step-close" targetRef="step-due2"/>
    <sequenceFlow id="flow-14" sourceRef="step-due2" targetRef="end-done"/>
    <sequenceFlow id="flow-15" name="refused" sourceRef="decision-approve" targetRef="end-refused"/>
    <sequenceFlow id="flow-16" name="amountCents == 0" sourceRef="step-route" targetRef="end-refused">
      <conditionExpression xsi:type="tFormalExpression" language="urn:specarch:expression">amountCents == 0</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-17" name="after P2D" sourceRef="deadline-approve" targetRef="end-refused"/>
    <sequenceFlow id="flow-18" name="after P1D" sourceRef="deadline-check" targetRef="step-recheck"/>
    <sequenceFlow id="flow-19" name="after P5D" sourceRef="deadline-confirmed" targetRef="end-refused"/>
    <sequenceFlow id="flow-20" name="fails" sourceRef="failure-pay" targetRef="end-failed"/>
    <sequenceFlow id="flow-21" name="fails" sourceRef="failure-close" targetRef="step-due2"/>
    <association id="association-hold" sourceRef="compensation-hold" targetRef="undo-hold" associationDirection="One"/>
  </process>
