  <process id="process" name="reinstate" isExecutable="false">
    <documentation>A written-off loan is reinstated when a desk supervisor confirms the book was found, within a day.</documentation>
    <startEvent id="start" name="requestReinstatement">
      <messageEventDefinition messageRef="message-requestReinstatement">
        <operationRef>operation-requestReinstatement</operationRef>
      </messageEventDefinition>
    </startEvent>
    <userTask id="step-confirmFound" name="confirmFound">
      <potentialOwner>
        <resourceRef>role-desk-supervisor</resourceRef>
      </potentialOwner>
    </userTask>
    <boundaryEvent id="deadline-confirmFound" attachedToRef="step-confirmFound" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">PT8H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <exclusiveGateway id="decision-confirmFound" name="approved?" default="flow-4"/>
    <endEvent id="end-done" name="done"/>
    <endEvent id="end-refused" name="refused"/>
    <sequenceFlow id="flow-1" sourceRef="start" targetRef="step-confirmFound"/>
    <sequenceFlow id="flow-2" sourceRef="step-confirmFound" targetRef="decision-confirmFound"/>
    <sequenceFlow id="flow-3" name="approved" sourceRef="decision-confirmFound" targetRef="end-done">
      <conditionExpression xsi:type="tFormalExpression">approved</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-4" name="refused" sourceRef="decision-confirmFound" targetRef="end-refused"/>
    <sequenceFlow id="flow-5" name="after PT8H" sourceRef="deadline-confirmFound" targetRef="end-refused"/>
  </process>
