data":{}}],"epss":[{"cve":"CVE-2023-54404","epss":0.00346,"percentile":0.27918,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2023-54404","cwe":"CWE-770","source":"disclosure@vulncheck.com","type":"Primary"},{"cve":"CVE-2023-54404","cwe":"CWE-1188","source":"disclosure@vulncheck.com","type":"Primary"}],"fix":{"versions":["4.6.6"],"state":"fixed","available":[{"version":"4.6.6","date":"2026-10-24","kind":"first-observed"}]},"advisories":[],"risk":0.265555},"relatedVulnerabilities":[{"id":"CVE-2023-54404","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2023-54404","namespace":"nvd:cpe","severity":"High","urls":["https://github.com/colinhacks/zod/issues/1872","https://github.com/colinhacks/zod/pull/6475","https://github.com/colinhacks/zod/pull/6652","https://www.vulncheck.com/advisories/zod-uncontrolled-resource-consumption-via-array-validation"],"description":"Zod schema-validation library contains an uncontrolled resource consumption vulnerability that allows attackers to exhaust memory by submitting a large array, set or map to an application that uses a container schema without an explicit size constraint. The handleArrayResult parse logic in $ZodArray (and the equivalent set and map paths) accumulates every validation issue for each failing element with no cap or early termination, causing the process to allocate one issue object per element and crash under out-of-memory conditions. This is reachable in the default configuration whenever a container schema such as z.array() is declared without a size bound. The upstream change in commit e06a510 (pull request 6652, first released in 4.6.6) only moves the .max(), .length() and .size() size checks to run before element parsing, so it rejects oversized input for schemas that declare an explicit upper bound; per the maintainer, unbounded containers are unchanged. No released version remediates the unbounded (default) case described here, and an opt-in setting to cap total accumulated errors was proposed but not merged.",