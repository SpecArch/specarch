  <process id="process" name="waiver" isExecutable="false">
    <documentation>A waiver is approved by the desk lead, or by the manager once a day has passed, before it is granted.</documentation>
    <startEvent id="start" name="askWaiver">
      <messageEventDefinition messageRef="message-askWaiver">
        <operationRef>operation-askWaiver</operationRef>
      </messageEventDefinition>
    </startEvent>
    <userTask id="step-lead" name="lead">
      <potentialOwner>
        <resourceRef>role-lead</resourceRef>
      </potentialOwner>
    </userTask>
    <boundaryEvent id="deadline-lead" attachedToRef="step-lead" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">P1D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <exclusiveGateway id="decision-lead" name="approved?" default="flow-7"/>
    <userTask id="step-manager" name="manager">
      <potentialOwner>
        <resourceRef>role-manager</resourceRef>
      </potentialOwner>
    </userTask>
    <!-- specarch-problem: question: open_question: (could, decision) Is three days the manager's deadline once the lead has passed the request on? Decided by manager. Answer with a decision record that names Q-1 under answers. [Q-1] -->
    <boundaryEvent id="deadline-manager" attachedToRef="step-manager" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">P3D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <exclusiveGateway id="decision-manager" name="approved?" default="flow-8"/>
    <serviceTask id="step-grant" name="grant" operationRef="operation-grantWaiver"/>
    <endEvent id="end-done" name="done"/>
    <endEvent id="end-refused" name="refused"/>
    <sequenceFlow id="flow-1" sourceRef="start" targetRef="step-lead"/>
    <sequenceFlow id="flow-2" sourceRef="step-lead" targetRef="decision-lead"/>
    <sequenceFlow id="flow-3" name="approved" sourceRef="decision-lead" targetRef="step-manager">
      <conditionExpression xsi:type="tFormalExpression">approved</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-4" sourceRef="step-manager" targetRef="decision-manager"/>
    <sequenceFlow id="flow-5" name="approved" sourceRef="decision-manager" targetRef="step-grant">
      <conditionExpression xsi:type="tFormalExpression">approved</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-6" sourceRef="step-grant" targetRef="end-done"/>
    <sequenceFlow id="flow-7" name="refused" sourceRef="decision-lead" targetRef="end-refused"/>
    <sequenceFlow id="flow-8" name="refused" sourceRef="decision-manager" targetRef="end-refused"/>
    <sequenceFlow id="flow-9" name="after P1D" sourceRef="deadline-lead" targetRef="step-manager"/>
    <sequenceFlow id="flow-10" name="after P3D" sourceRef="deadline-manager" targetRef="end-refused"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram-waiver">
    <bpmndi:BPMNPlane id="plane-waiver" bpmnElement="process">
