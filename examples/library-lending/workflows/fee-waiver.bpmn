    <sequenceFlow id="flow-7" name="refused" sourceRef="decision-approve" targetRef="end-refused"/>
    <sequenceFlow id="flow-8" name="after P3D" sourceRef="deadline-approve" targetRef="end-refused"/>
    <sequenceFlow id="flow-9" name="fails" sourceRef="failure-waive" targetRef="end-failed"/>
  </process>
