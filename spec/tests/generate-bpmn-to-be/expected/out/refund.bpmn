  <process id="process" name="refund" isExecutable="false">
    <documentation>A large refund is approved by a manager; the funds are held, then paid.</documentation>
    <laneSet id="lanes">
      <lane id="lane" name="Case">
        <flowNodeRef>start</flowNodeRef>
        <flowNodeRef>step-route</flowNodeRef>
        <flowNodeRef>decision-approve</flowNodeRef>
        <flowNodeRef>step-hold</flowNodeRef>
        <flowNodeRef>compensation-hold</flowNodeRef>
        <flowNodeRef>undo-hold</flowNodeRef>
        <flowNodeRef>step-pay</flowNodeRef>
        <flowNodeRef>end-done</flowNodeRef>
        <flowNodeRef>end-refused</flowNodeRef>
      </lane>
      <lane id="lane-manager" name="manager">
        <flowNodeRef>step-approve</flowNodeRef>
        <flowNodeRef>deadline-approve</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="start" name="askRefund">
      <messageEventDefinition messageRef="message-askRefund">
        <operationRef>operation-askRefund</operationRef>
      </messageEventDefinition>
    </startEvent>
    <exclusiveGateway id="step-route" name="route" default="flow-5"/>
    <userTask id="step-approve" name="approve">
      <potentialOwner>
        <resourceRef>role-manager</resourceRef>
      </potentialOwner>
    </userTask>
    <boundaryEvent id="deadline-approve" attachedToRef="step-approve" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">P2D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <exclusiveGateway id="decision-approve" name="approved?" default="flow-8"/>
    <serviceTask id="step-hold" name="hold" operationRef="operation-holdFunds"/>
    <boundaryEvent id="compensation-hold" attachedToRef="step-hold">
      <compensateEventDefinition/>
    </boundaryEvent>
    <serviceTask id="undo-hold" name="undo hold" isForCompensation="true" operationRef="operation-releaseFunds"/>
    <serviceTask id="step-pay" name="pay" operationRef="operation-payRefund"/>
    <endEvent id="end-done" name="done"/>
    <endEvent id="end-refused" name="refused">
      <compensateEventDefinition/>
    </endEvent>
    <sequenceFlow id="flow-1" sourceRef="start" targetRef="step-route"/>
    <sequenceFlow id="flow-2" name="amountCents &gt; 10000" sourceRef="step-route" targetRef="step-approve">
      <conditionExpression xsi:type="tFormalExpression" language="urn:specarch:expression">amountCents &gt; 10000</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-3" sourceRef="step-approve" targetRef="decision-approve"/>
    <sequenceFlow id="flow-4" name="approved" sourceRef="decision-approve" targetRef="step-hold">
      <conditionExpression xsi:type="tFormalExpression">approved</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-5" name="otherwise" sourceRef="step-route" targetRef="step-hold"/>
    <sequenceFlow id="flow-6" sourceRef="step-hold" targetRef="step-pay"/>
    <sequenceFlow id="flow-7" sourceRef="step-pay" targetRef="end-done"/>
    <sequenceFlow id="flow-8" name="refused" sourceRef="decision-approve" targetRef="end-refused"/>
    <sequenceFlow id="flow-9" name="after P2D" sourceRef="deadline-approve" targetRef="end-refused"/>
    <association id="association-hold" sourceRef="compensation-hold" targetRef="undo-hold" associationDirection="One"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram-refund">
    <bpmndi:BPMNPlane id="plane-refund" bpmnElement="process">
      <bpmndi:BPMNShape id="shape-lane" bpmnElement="lane" isHorizontal="true">
