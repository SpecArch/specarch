https://github.com/vercel/next.js/security/advisories/GHSA-f3mh-rxg3-f5g2","https://nextjs.org/blog/november-2026-security-release"],"description":"Next.js is a React framework for building full-stack web applications. From 15.0.0 until 15.5.29 and 16.4.5, Next.js applications that use NextResponse to set cookies on Edge runtime routes expose the internal x-middleware-set-cookie header in the public response. This affects App Router route handlers and Pages Router Edge API routes. The header duplicates each cookie value and its attributes, so JavaScript already running on the same origin can read values that the Set-Cookie header marks HttpOnly, including sensitive session tokens set on an affected response. This issue is fixed in versions 16.4.5 and 15.5.29.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:H/AT:N/PR:N/UI:P/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-119346","epss":0.00301,"percentile":0.23018,"date":"2026-11-24"}],"cwes":[{"cve":"CVE-2026-119346","cwe":"CWE-200","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2026-119346","cwe":"CWE-201","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"next","version":"16.4.1"}},"found":{"vulnerabilityID":"GHSA-f3mh-rxg3-f5g2","versionConstraint":">=16.0.0,<=16.4.4 (semantic)"},"fix":{"suggestedVersion":"16.4.5"}}],"artifact":{"id":"pkg:npm/next@16.4.1?package-id=0337ccfbbb37b149","name":"next","version":"16.4.1","type":"npm","locations":[{"path":"/examples/library-lending/web-nextjs/pnpm-lock.yaml","accessPath":""}],"language":"javascript","licenses":[],"cpes":["cpe:2.3:a:vercel:next.js:16.4.1:*:*:*:*:node.js:*:*"],"purl":"pkg:npm/next@16.4.1","upstreams":[]}},{"vulnerability":{"id":"GHSA-vc7v-qv4w-wrv8","dataSource":"https://github.com/advisories/GHSA-vc7v-qv4w-wrv8","namespace":"github:language:javascript","severity":"Medium","urls":["https://github.com/vercel/next.js/security/advisories/GHSA-vc7v-qv4w-wrv8","https://nvd.nist.gov/vuln/detail/CVE-2026-119351","https://github.com/vercel/next.js/commit/80c96ede21798d4ad54da12fe50d5b00a09b06e3","https://github.com/vercel/next.js/releases/tag/v16.4.5","https://nextjs.org/blog/november-2026-security-release"],"description":"Next.js: Cache leak across root param values in nested 'use cache' functions via delayed inner stream metadata","cvss":[{"type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N","metrics":{"baseScore":6.3},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-119351","epss":0.0024,"percentile":0.15095,"date":"2026-11-24"}],"cwes":[{"cve":"CVE-2026-119351","cwe":"CWE-362","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["16.4.5"],"state":"fixed","available":[{"version":"16.4.5","date":"2026-11-17","kind":"first-observed"}]},"advisories":[],"risk":0.13559999999999997},"relatedVulnerabilities":[{"id":"CVE-2026-119351","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-119351","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/vercel/next.js/commit/80c96ede21798d4ad54da12fe50d5b00a09b06e3","https://github.com/vercel/next.js/releases/tag/v16.4.5","https://github.com/vercel/next.js/security/advisories/GHSA-vc7v-qv4w-wrv8","https://nextjs.org/blog/november-2026-security-release"],"description":"Next.js is a React framework for building full-stack web applications. From 16.2.0 until 16.4.5, Next.js applications with Cache Components enabled can reuse an outer 'use cache' entry across root param values when a nested 'use cache' call reads a root param through next/root-params and returns a value containing pending promises. React Flight can deliver the ready portion to the outer function before the inner cache finishes publishing its root-param dependencies. The outer entry can then complete and be persisted under a key that omits the root param, causing the first written value to be served for other root param values and allowing the outer entry to ignore nested cache tag invalidation and lifetimes. The leaked value is not attacker controlled and depends on which invocation writes the entry first. This variant does not require an existing inner cache entry or a slow cache handler and is not covered by the fix for CVE-2026-103004. This issue is fixed in version 16.4.5.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":6.3},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-119351","epss":0.0024,"percentile":0.15095,"date":"2026-11-24"}],"cwes":[{"cve":"CVE-2026-119351","cwe":"CWE-362","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"next","version":"16.4.1"}},"found":{"vulnerabilityID":"GHSA-vc7v-qv4w-wrv8","versionConstraint":">=16.2.0,<=16.4.4 (semantic)"},"fix":{"suggestedVersion":"16.4.5"}}],"artifact":{"id":"pkg:npm/next@16.4.1?package-id=0337ccfbbb37b149","name":"next","version":"16.4.1","type":"npm","locations":[{"path":"/examples/library-lending/web-nextjs/pnpm-lock.yaml","accessPath":""}],"language":"javascript","licenses":[],"cpes":["cpe:2.3:a:vercel:next.js:16.4.1:*:*:*:*:node.js:*:*"],"purl":"pkg:npm/next@16.4.1","upstreams":[]}},{"vulnerability":{"id":"GHSA-vvgp-ww4w-46vf","dataSource":"https://github.com/advisories/GHSA-vvgp-ww4w-46vf","namespace":"github:language:javascript","severity":"Medium","urls":["https://github.com/vercel/next.js/security/advisories/GHSA-vvgp-ww4w-46vf","https://nvd.nist.gov/vuln/detail/CVE-2026-119350","https://github.com/vercel/next.js/commit/18eeffb5fabd91911852d44cf56948b3f2cbee04","https://github.com/vercel/next.js/releases/tag/v16.4.5","https://nextjs.org/blog/november-2026-security-release"],"description":"Next.js: Cache poisoning of shared fallback shells in Cache Components via request-supplied placeholder route params","cvss":[{"type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:N/VI:L/VA:L/SC:N/SI:N/SA:N","metrics":{"baseScore":6.3},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-119350","epss":0.00219,"percentile":0.12305,"date":"2026-11-24"}],"cwes":[{"cve":"CVE-2026-119350","cwe":"CWE-349","source":"security-advisories@github.com","type":"Primary"}],"fix":{"versions":["16.4.5"],"state":"fixed","available":[{"version":"16.4.5","date":"2026-11-20","kind":"first-observed"}]},"advisories":[],"risk":0.12373499999999998},"relatedVulnerabilities":[{"id":"CVE-2026-119350","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-119350","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/vercel/next.js/commit/18eeffb5fabd91911852d44cf56948b3f2cbee04","https://github.com/vercel/next.js/releases/tag/v16.4.5","https://github.com/vercel/next.js/security/advisories/GHSA-vvgp-ww4w-46vf","https://nextjs.org/blog/november-2026-security-release"],"description":"Next.js is a React framework for building full-stack web applications. From 16.4.0 until 16.4.5, self-hosted Next.js applications served with next start can allow an unauthenticated request to poison a shared fallback shell when cacheComponents is true and partialPrefetching is unset or false. The affected dynamic route must have a prerenderable param declared by generateStaticParams whose requested value was not generated at build time, at least two never-prerenderable params below it, a layout that reads the shallower param inside a Suspense boundary, and a blocking fallback shell. A request-supplied placeholder route param whose path segment equals the percent-encoded bracketed name of its own deeper route param is incorrectly treated as unresolved, while the shallower concrete value is rendered into the shared shell and its HTTP status is persisted. Depending on application behavior, subsequent routes sharing that shell can receive a persistent 404 or attacker-selected substituted param text. Client hydration corrects substituted text, and the issue does not enable markup or script injection or disclose data. This issue is fixed in version 16.4.5.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:N/VI:L/VA:L/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":6.3},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-119350","epss":0.00219,"percentile":0.12305,"date":"2026-11-24"}],"cwes":[{"cve":"CVE-2026-119350","cwe":"CWE-349","source":"security-advisories@github.com","type":"Primary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"next","version":"16.4.1"}},"found":{"vulnerabilityID":"GHSA-vvgp-ww4w-46vf","versionConstraint":">=16.4.0,<=16.4.4 (semantic)"},"fix":{"suggestedVersion":"16.4.5"}}],"artifact":{"id":"pkg:npm/next@16.4.1?package-id=0337ccfbbb37b149","name":"next","version":"16.4.1","type":"npm","locations":[{"path":"/examples/library-lending/web-nextjs/pnpm-lock.yaml","accessPath":""}],"language":"javascript","licenses":[],"cpes":["cpe:2.3:a:vercel:next.js:16.4.1:*:*:*:*:node.js:*:*"],"purl":"pkg:npm/next@16.4.1","upstreams":[]}}],"source":{"type":"file","target":"."},"distro":{"