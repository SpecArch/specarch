ns. Prior to 15.5.29 and 16.4.5, self-hosted Next.js App Router route handlers and the fetch cache that return a fetched upstream response unchanged can emit a response whose declared framing does not match the body actually sent. When the application is behind an HTTP/1.1 reverse proxy that permits pipelined response queueing, a crafted upstream response can desynchronize responses between clients. The resulting desynchronization can inject a response into another client's queue or disclose another client's response. This issue is fixed in versions 16.4.5 and 15.5.29.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:H/AT:P/PR:N/UI:N/VC:L/VI:L/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":6.3},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-119348","epss":0.00479,"percentile":0.41899,"date":"2026-11-24"}],"cwes":[{"cve":"CVE-2026-119348","cwe":"CWE-444","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"next","version":"16.4.1"}},"found":{"vulnerabilityID":"GHSA-pc58-hwjq-p385","versionConstraint":">=16.0.0,<=16.4.4 (semantic)"},"fix":{"suggestedVersion":"16.4.5"}}],"artifact":{"id":"pkg:npm/next@16.4.1?package-id=0337ccfbbb37b149","name":"next","version":"16.4.1","type":"npm","locations":[{"path":"/examples/library-lending/web-nextjs/pnpm-lock.yaml","accessPath":""}],"language":"javascript","licenses":[],"cpes":["cpe:2.3:a:vercel:next.js:16.4.1:*:*:*:*:node.js:*:*"],"purl":"pkg:npm/next@16.4.1","upstreams":[]}},{"vulnerability":{"id":"GHSA-g3hv-75wg-m249","dataSource":"https://github.com/advisories/GHSA-g3hv-75wg-m249","namespace":"github:language:javascript","severity":"Medium","urls":["https://github.com/isaa